# Copy to .env and fill in. Never commit .env.

# --- Answering model (OpenAI-compatible endpoint) ---
# Swapping providers is a two-line change: LLM_BASE_URL and LLM_MODEL.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=

# --- Embeddings (Voyage AI) ---
# voyage-4 is multilingual, so Turkish questions retrieve English chunks.
EMBEDDING_MODEL=voyage-4
VOYAGE_API_KEY=

# --- Vector store (Qdrant Cloud) ---
QDRANT_CLUSTER_ENDPOINT=
QDRANT_CLUSTER_API_KEY=
QDRANT_COLLECTION=chatbot_chunks

# --- Retrieval tuning. Change these before changing code. ---
# How many chunks are sent to the model.
TOP_K=4
# Cosine score below which a chunk is discarded before the model is consulted.
# Deliberately low: valid but vague questions score in the same 0.12-0.18 band
# as off-topic ones, so no cutoff separates them. Above the floor the model
# decides whether the excerpts cover the question. See README, "About SCORE_FLOOR".
SCORE_FLOOR=0.08

# --- Chunking tuning. Re-upload documents after changing these. ---
CHUNK_SIZE=1500
CHUNK_OVERLAP=200
